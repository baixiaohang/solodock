[Unit]
Description=SoloDock container deployment console
Documentation=https://github.com/baixiaohang/solodock
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=solodock
Group=solodock
SupplementaryGroups=docker
Environment=SOLODOCK_CONFIG_PATH=/etc/solodock/config.toml
Environment=RUST_LOG=solodock=info
ExecStart=/usr/local/bin/solodock
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077

StateDirectory=solodock
StateDirectoryMode=0700
RuntimeDirectory=solodock
RuntimeDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=256
LimitNOFILE=4096
MemoryHigh=256M

[Install]
WantedBy=multi-user.target
