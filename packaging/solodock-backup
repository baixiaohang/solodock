#!/usr/bin/env bash
set -euo pipefail

script_path=$(realpath -e -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")

inspect_packaged_config() {
  local inspector=$1 config=$2 output health authority management
  local -a fields
  output=$("$inspector" inspect-packaged-config "$config") || return 1
  mapfile -t fields <<<"$output"
  [[ ${#fields[@]} == 4 ]] || return 1
  [[ ${fields[0]} == 'FORMAT=solodock-packaged-config-v1' ]] || return 1
  [[ ${fields[1]} == HEALTH_URL=* ]] || return 1
  health=${fields[1]#HEALTH_URL=}
  [[ -n $health && ${#health} -le 320 && $health != *[$' \t\r\n']* ]] || return 1
  authority=${health#http://}
  authority=${authority%/healthz}
  [[ -n $authority && $health == "http://$authority/healthz" && $authority != *['/?#@\']* ]] || return 1
  [[ ${fields[2]} == "LOCAL_AUTHORITY=$authority" ]] || return 1
  [[ ${fields[3]} == MANAGEMENT_AUTHORITY=* ]] || return 1
  management=${fields[3]#MANAGEMENT_AUTHORITY=}
  [[ -n $management && ${#management} -le 320 && $management != *[$' \t\r\n']* && $management != *['/?#@\']* ]] || return 1
}

validate_managed_links() {
  local state_root=$1
  local uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
  local link relative target app
  while IFS= read -r -d '' link; do
    relative=${link#"$state_root/"}
    if [[ ! $relative =~ ^apps/($uuid)/(active|pending)$ ]]; then
      return 1
    fi
    app=${BASH_REMATCH[1]}
    target=$(readlink -- "$link")
    if [[ ! $target =~ ^releases/($uuid)$ || ! -d $state_root/apps/$app/$target || -L $state_root/apps/$app/$target ]]; then
      return 1
    fi
  done < <(find "$state_root" -xdev -type l -print0)
}

open_safe_parent() {
  local candidate=$1 component component_uid component_mode
  parent_real=$(realpath -e -- "$candidate") || return 1
  [[ $parent_real == "$candidate" && -d $parent_real && ! -L $parent_real ]] || return 1
  component=$parent_real
  while :; do
    component_uid=$(stat -c '%u' -- "$component") || return 1
    component_mode=$(stat -c '%a' -- "$component") || return 1
    [[ $component_uid == 0 || $component_uid == "$(id -u)" ]] || return 1
    if ((8#$component_mode & 8#022)); then
      ((8#$component_mode & 8#1000)) || return 1
    fi
    [[ $component == / ]] && break
    component=$(dirname -- "$component")
  done
  parent_uid=$(stat -c '%u' -- "$parent_real") || return 1
  parent_mode=$(stat -c '%a' -- "$parent_real") || return 1
  [[ $parent_uid == "$(id -u)" && $((8#$parent_mode & 8#022)) -eq 0 ]] || return 1
  parent_path_identity=$(stat -Lc '%d:%i' -- "$parent_real") || return 1
  exec {parent_fd}<"$parent_real" || return 1
  parent_anchor="/proc/$$/fd/$parent_fd"
  [[ $(stat -Lc '%d:%i' -- "$parent_anchor") == "$parent_path_identity" ]] || return 1
}

recheck_parent() {
  [[ $(realpath -e -- "$parent") == "$parent_real" \
    && $(stat -Lc '%d:%i' -- "$parent") == "$parent_path_identity" \
    && $(stat -Lc '%d:%i' -- "$parent_anchor") == "$parent_path_identity" ]]
}

root=''
output=''
validator=''
while (($#)); do
  case "$1" in
    --root) root=${2-}; shift 2 ;;
    --output) output=${2-}; shift 2 ;;
    --validator) validator=${2-}; shift 2 ;;
    *) printf '%s\n' 'usage: solodock-backup [--root STAGING_ROOT] [--validator PATH] --output ARCHIVE' >&2; exit 2 ;;
  esac
done
[[ $output = /* && ! -e $output && ! -L $output && ! -e $output.sha256 && ! -L $output.sha256 ]] || { printf '%s\n' 'output and checksum must be new absolute paths' >&2; exit 2; }
if [[ -n $root ]]; then
  [[ $root = /* && $root != / && ! -L $root ]] || { printf '%s\n' 'unsafe staging root' >&2; exit 2; }
else
  root=''
  if systemctl is-active --quiet solodock.service; then
    printf '%s\n' 'stop solodock.service before backup' >&2
    exit 1
  fi
fi
if [[ -n $validator ]]; then
  [[ -n $root ]] || { printf '%s\n' '--validator is available only with --root' >&2; exit 2; }
else
  validator="$script_dir/solodock"
fi
[[ -x $validator && ! -L $validator ]] || { printf '%s\n' 'backup validator is missing or unsafe' >&2; exit 2; }
validator=$(realpath -e -- "$validator")
state="$root/var/lib/solodock"
config="$root/etc/solodock/config.toml"
for component in "$root/var" "$root/var/lib" "$state" "$root/etc" "$root/etc/solodock" "$config"; do
  [[ ! -L $component ]] || { printf '%s\n' 'backup input contains a symlink component' >&2; exit 1; }
done
for path in "$state" "$config"; do
  [[ -e $path && ! -L $path ]] || { printf '%s\n' 'required backup input is missing or unsafe' >&2; exit 1; }
done
[[ -d $state && -f $config ]] || { printf '%s\n' 'backup inputs have invalid types' >&2; exit 1; }
inspect_packaged_config "$validator" "$config" || { printf '%s\n' 'backup configuration is not a valid packaged layout' >&2; exit 1; }
if ! validate_managed_links "$state" || find "$state" -xdev \( ! -type d ! -type f ! -type l \) -print -quit | grep -q .; then
  printf '%s\n' 'state contains an unsafe link or unsupported file type' >&2
  exit 1
fi
case "$output" in "$state"/*) printf '%s\n' 'output cannot be inside state' >&2; exit 2;; esac
mode=$(stat -c '%a' "$config")
[[ $mode == 600 ]] || { printf '%s\n' 'config permissions must be 0600' >&2; exit 1; }
[[ $(stat -c '%a' "$state") == 700 ]] || { printf '%s\n' 'state permissions must be 0700' >&2; exit 1; }
if [[ -z ${root} ]]; then
  [[ $(stat -c '%U:%G' "$state") == solodock:solodock && $(stat -c '%U:%G' "$config") == solodock:solodock ]] || { printf '%s\n' 'backup inputs have unsafe ownership' >&2; exit 1; }
fi
parent=$(dirname -- "$output")
open_safe_parent "$parent" || { printf '%s\n' 'output parent or one of its ancestors is unsafe' >&2; exit 1; }
output_name=$(basename -- "$output")
anchored_output="$parent_anchor/$output_name"
[[ ! -e $anchored_output && ! -L $anchored_output && ! -e $anchored_output.sha256 && ! -L $anchored_output.sha256 ]] || { printf '%s\n' 'output and checksum must remain new paths' >&2; exit 2; }
umask 077
tmp=$(mktemp "$parent_anchor/.solodock-backup.XXXXXX")
sumtmp=$(mktemp "$parent_anchor/.solodock-backup-checksum.XXXXXX")
archive_published=0
checksum_published=0
cleanup() {
  if ((checksum_published)) && [[ $anchored_output.sha256 -ef $sumtmp ]]; then rm -f -- "$anchored_output.sha256"; fi
  if ((archive_published)) && [[ $anchored_output -ef $tmp ]]; then rm -f -- "$anchored_output"; fi
  rm -f -- "$tmp" "$sumtmp"
}
trap cleanup EXIT
recheck_parent || { printf '%s\n' 'output parent identity changed before backup' >&2; exit 1; }
tar --format=pax --numeric-owner --one-file-system -C "$root/" -cf "$tmp" var/lib/solodock etc/solodock/config.toml
chmod 0600 "$tmp"
sync -f "$tmp"
digest=$(sha256sum "$tmp" | awk '{print $1}')
printf '%s  %s\n' "$digest" "$(basename -- "$output")" >"$sumtmp"
chmod 0600 "$sumtmp"
sync -f "$sumtmp"
recheck_parent || { printf '%s\n' 'output parent identity changed before publication' >&2; exit 1; }
ln -- "$tmp" "$anchored_output"
archive_published=1
ln -- "$sumtmp" "$anchored_output.sha256"
checksum_published=1
sync -f "$parent_anchor"
recheck_parent || { printf '%s\n' 'output parent identity changed during publication' >&2; exit 1; }
rm -f -- "$tmp" "$sumtmp"
trap - EXIT
exec {parent_fd}<&-
printf '%s\n' 'offline SoloDock control-plane backup completed'
