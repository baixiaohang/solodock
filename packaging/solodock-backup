#!/usr/bin/env bash
set -euo pipefail

validate_managed_links() {
  local state_root=$1
  local uuid='[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'
  local link relative target app
  while IFS= read -r -d '' link; do
    relative=${link#"$state_root/"}
    if [[ ! $relative =~ ^apps/($uuid)/(active|pending)$ ]]; then
      return 1
    fi
    app=${BASH_REMATCH[1]}
    target=$(readlink -- "$link")
    if [[ ! $target =~ ^releases/($uuid)$ || ! -d $state_root/apps/$app/$target || -L $state_root/apps/$app/$target ]]; then
      return 1
    fi
  done < <(find "$state_root" -xdev -type l -print0)
}

root=''
output=''
while (($#)); do
  case "$1" in
    --root) root=${2-}; shift 2 ;;
    --output) output=${2-}; shift 2 ;;
    *) printf '%s\n' 'usage: solodock-backup [--root STAGING_ROOT] --output ARCHIVE' >&2; exit 2 ;;
  esac
done
[[ $output = /* && ! -e $output && ! -L $output && ! -e $output.sha256 && ! -L $output.sha256 ]] || { printf '%s\n' 'output and checksum must be new absolute paths' >&2; exit 2; }
if [[ -n $root ]]; then
  [[ $root = /* && $root != / && ! -L $root ]] || { printf '%s\n' 'unsafe staging root' >&2; exit 2; }
else
  root=''
  if systemctl is-active --quiet solodock.service; then
    printf '%s\n' 'stop solodock.service before backup' >&2
    exit 1
  fi
fi
state="$root/var/lib/solodock"
config="$root/etc/solodock/config.toml"
for component in "$root/var" "$root/var/lib" "$state" "$root/etc" "$root/etc/solodock" "$config"; do
  [[ ! -L $component ]] || { printf '%s\n' 'backup input contains a symlink component' >&2; exit 1; }
done
for path in "$state" "$config"; do
  [[ -e $path && ! -L $path ]] || { printf '%s\n' 'required backup input is missing or unsafe' >&2; exit 1; }
done
[[ -d $state && -f $config ]] || { printf '%s\n' 'backup inputs have invalid types' >&2; exit 1; }
if ! validate_managed_links "$state" || find "$state" -xdev \( ! -type d ! -type f ! -type l \) -print -quit | grep -q .; then
  printf '%s\n' 'state contains an unsafe link or unsupported file type' >&2
  exit 1
fi
case "$output" in "$state"/*) printf '%s\n' 'output cannot be inside state' >&2; exit 2;; esac
mode=$(stat -c '%a' "$config")
[[ $mode == 600 ]] || { printf '%s\n' 'config permissions must be 0600' >&2; exit 1; }
[[ $(stat -c '%a' "$state") == 700 ]] || { printf '%s\n' 'state permissions must be 0700' >&2; exit 1; }
if [[ -z ${root} ]]; then
  [[ $(stat -c '%U:%G' "$state") == solodock:solodock && $(stat -c '%U:%G' "$config") == solodock:solodock ]] || { printf '%s\n' 'backup inputs have unsafe ownership' >&2; exit 1; }
fi
parent=$(dirname -- "$output")
[[ -d $parent && ! -L $parent && $(realpath -e -- "$parent") == "$parent" ]] || { printf '%s\n' 'output parent is unsafe' >&2; exit 1; }
tmp="$parent/.solodock-backup-$$.tmp"
sumtmp="$parent/.solodock-backup-$$.sha256.tmp"
trap 'rm -f -- "$tmp" "$sumtmp"' EXIT
umask 077
tar --format=pax --numeric-owner --one-file-system -C "$root/" -cf "$tmp" var/lib/solodock etc/solodock/config.toml
chmod 0600 "$tmp"
sync -f "$tmp"
digest=$(sha256sum "$tmp" | awk '{print $1}')
printf '%s  %s\n' "$digest" "$(basename -- "$output")" >"$sumtmp"
chmod 0600 "$sumtmp"
sync -f "$sumtmp"
mv -- "$tmp" "$output"
mv -- "$sumtmp" "$output.sha256"
sync -f "$parent"
trap - EXIT
printf '%s\n' 'offline SoloDock control-plane backup completed'
